# Copy to .env and fill in locally. Never commit .env.

# Target warehouse: bigquery or snowflake
WAREHOUSE_TARGET=bigquery

# Share of members to keep, from 1 to 100
MEMBER_SAMPLE_PCT=10

# Local folder for downloaded files
DATA_DIR=data

# BigQuery
GCP_PROJECT_ID=
GCP_LOCATION=US
RAW_DATASET=raw
# Days until raw tables expire. The sandbox allows at most 60. Use 0 for no expiry.
RAW_EXPIRATION_DAYS=60
# Reload raw tables this many days before they expire
RAW_REFRESH_DAYS=14
# Full path to a service account key stored outside this repository
GOOGLE_APPLICATION_CREDENTIALS=

# Snowflake (names match platforms/snowflake/setup.sql)
# Account identifier, format orgname-accountname, shown by the last query in setup.sql
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=CLAIMS_SERVICE
# Full path to the private key, stored outside this repository
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_ROLE=CLAIMS_TRANSFORMER
SNOWFLAKE_WAREHOUSE=CLAIMS_WH
SNOWFLAKE_DATABASE=CLAIMS_WAREHOUSE

# Databricks (Free Edition)
# Workspace URL, for example https://dbc-1234abcd-5678.cloud.databricks.com
DATABRICKS_HOST=
# SQL warehouse HTTP path, from SQL Warehouses > your warehouse > Connection details
DATABRICKS_HTTP_PATH=
# Personal access token, from Settings > Developer > Access tokens
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=workspace

# Alerts
DISCORD_WEBHOOK_URL=
