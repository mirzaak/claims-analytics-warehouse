# Copy to .env and fill in locally. Never commit .env.

# Target warehouse: bigquery or snowflake
WAREHOUSE_TARGET=bigquery

# Share of members to keep, from 1 to 100
MEMBER_SAMPLE_PCT=10

# Local folder for downloaded files
DATA_DIR=data

# BigQuery
GCP_PROJECT_ID=
GCP_LOCATION=US
RAW_DATASET=raw
# Days until raw tables expire. The sandbox allows at most 60. Use 0 for no expiry.
RAW_EXPIRATION_DAYS=60
# Reload raw tables this many days before they expire
RAW_REFRESH_DAYS=14
# Full path to a service account key stored outside this repository
GOOGLE_APPLICATION_CREDENTIALS=

# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=

# Alerts
DISCORD_WEBHOOK_URL=
